PORT=5000
NODE_ENV=development

# Local MongoDB (Compass) or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/pyq-hub

# any long random string
JWT_SECRET=change-this-to-a-long-random-string

# React app URL (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# Public URL of this server (used for locally saved files)
SERVER_URL=http://localhost:5000

# Optional - fill these to store files on Cloudinary (needed after deploy)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
